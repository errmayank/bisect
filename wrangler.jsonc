{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bisect",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bisect",
      "database_id": "054feb05-ff29-4ce3-a0ee-ce85758154d5",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "vars": {
    "TURNSTILE_HOSTNAME": "bisect.errmayank.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEsse8l6ZVg99RKF",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "MAINTENANCE_MODE"],
  },
}
